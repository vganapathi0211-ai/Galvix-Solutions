# ── Vercel Environment Variables (set in Vercel Dashboard → Settings → Environment Variables) ──

# Google Apps Script web app URL (handles contact form → Sheet + Telegram + Email)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# OpenAI API key for the chatbot (server-side only — never expose with VITE_ prefix)
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_MODEL=gpt-4o-mini

# ── Frontend (VITE_ prefix = bundled into browser — NO secrets here) ──
VITE_API_BASE_URL=
